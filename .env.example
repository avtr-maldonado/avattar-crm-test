# ===========================================================================
# Copiar a .env.local y llenar con los valores del proyecto EN LA NUBE.
#
# Proyecto: cjwahoscedjnjgalmyzu  ·  https://cjwahoscedjnjgalmyzu.supabase.co
#
# No se usa un Postgres local: el SSO de Entra ID está configurado en el
# proyecto de la nube, y ahí es donde se aplican y verifican las migraciones.
# ===========================================================================

# ---------------------------------------------------------------------------
# Supabase · identidad (Entra ID) y almacenamiento
# Dashboard → Project Settings → API
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://cjwahoscedjnjgalmyzu.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Solo para operaciones administrativas de Supabase (firmar URLs de Storage,
# alta de usuarios). NUNCA para leer datos de negocio: eso saltaría lib/scope
# y con ello INV-01. No prefijar con NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Prisma · datos
# Dashboard → botón "Connect" → pestaña "ORMs" → "Prisma".
# Ese panel emite las dos líneas ya armadas; solo falta la contraseña
# (Project Settings → Database → Reset database password).
#
# La diferencia entre ambas es el PUERTO, no el host:
#
#   6543  pooler en modo TRANSACCIÓN. Lo usa la aplicación en cada request.
#         Exige ?pgbouncer=true o Prisma falla por sentencias preparadas.
#
#   5432  pooler en modo SESIÓN. Soporta transacciones largas, así que es el
#         que necesitan las migraciones y `pnpm db:seed`.
#
# NO uses db.cjwahoscedjnjgalmyzu.supabase.co para DIRECT_URL: la conexión
# directa es IPv6 salvo que se contrate el complemento de IPv4, y en una red
# IPv4 el seed falla con ENETUNREACH sin decir por qué. El pooler en sesión
# hace el mismo trabajo sobre IPv4.
#
# Si la contraseña trae @ # / o :, hay que codificarla en porcentaje.
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres.cjwahoscedjnjgalmyzu:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.cjwahoscedjnjgalmyzu:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# ---------------------------------------------------------------------------
# Microsoft Graph · calendario de Microsoft 365 (F-605)
#
# Las actividades POR HACER se agendan en el calendario de su responsable.
# Flujo de aplicación (client credentials): el registro de aplicación necesita
# Calendars.ReadWrite como permiso DE APLICACIÓN con consentimiento de
# administrador. OnlineMeetings.* no hace falta: la videollamada se crea
# marcando el evento como reunión de Teams.
#
# Sin las tres variables, el CRM no toca el calendario y todo lo demás sigue
# funcionando igual. Puede ser el mismo registro que el SSO.
# ---------------------------------------------------------------------------
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# ===========================================================================
# PRODUCCIÓN · .env.production.local
#
# Desde el 12 de octubre de 2026 hay dos proyectos de Supabase:
#
#   DEV   cjwahoscedjnjgalmyzu   .env.local              lo que lee pnpm dev
#   PROD  luujtoutcpswhewsxmja   .env.production.local   solo migraciones y
#                                                        catálogos desde aquí
#
# El archivo de producción NO se copia a .env.local y NO lo lee la aplicación
# local: lo leen, y solo cuando se les nombra, los dos comandos que escriben
# en un ambiente declarado.
#
#   node aplicar-migraciones.mjs --env .env.production.local --dry-run
#   node aplicar-migraciones.mjs --env .env.production.local
#   pnpm db:seed:catalogos --env .env.production.local \
#     --admin "correo@avattar.com|Nombre Apellido|ADMINISTRADOR|MX,CO,CL"
#
# Los dos imprimen a qué host van antes de escribir, porque la única
# diferencia entre tocar desarrollo y tocar producción es un nombre de
# archivo, y en producción no hay deshacer.
#
# Para producción bastan las dos cadenas de Prisma; la anon key y la
# service_role son de la aplicación y viven en Vercel, no aquí. Las de
# Microsoft Graph solo si el calendario se enciende en producción.
#
# Dónde salen los valores, en el proyecto PROD:
#   DATABASE_URL / DIRECT_URL   botón "Connect" → pestaña "ORMs" → "Prisma"
#                               (la contraseña: Project Settings → Database)
#   NEXT_PUBLIC_SUPABASE_*      Project Settings → API
#
# La región del pooler puede no ser la misma que la de DEV: copiar el host
# tal como lo emite el panel, no sustituir el ref en el de desarrollo.
# ===========================================================================

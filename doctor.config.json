{
  "ignore": {
    "files": [
      "supabase/migrations/_archivo_v1/**",
      "docs/**",
      ".agents/**",
      ".claude/**"
    ],
    "overrides": [
      {
        "files": [
          "app/(auth)/login/**",
          ".next/**"
        ],
        "rules": [
          "react-doctor/artifact-secret-leak",
          "react-doctor/artifact-baas-authority-surface"
        ]
      },
      {
        "files": [
          "prisma/seed.ts"
        ],
        "rules": [
          "react-doctor/async-await-in-loop"
        ]
      },
      {
        "files": [
          "components/pipeline/NuevaOportunidad.tsx"
        ],
        "rules": [
          "react-doctor/nextjs-no-client-side-redirect"
        ]
      }
    ]
  }
}
